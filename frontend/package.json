{
  "name": "health-upgrades-frontend",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && npm run lint:scripts",
    "lint:scripts": "cd .. && eslint --config frontend/eslint.config.js --report-unused-disable-directives --max-warnings 0 scripts",
    "format": "prettier --write --config prettier.config.js . ../package.json ../scripts ../e2e/package.json ../e2e/playwright.config.ts ../e2e/tests",
    "format:check": "prettier --check --config prettier.config.js . ../package.json ../scripts ../e2e/package.json ../e2e/playwright.config.ts ../e2e/tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:colours": "node scripts/check-colours.mjs"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.5.0",
    "@tanstack/react-query": "^5.104.3",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.32",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
