# Java / Maven
backend/target/
*.class
*.jar
*.war
*.ear

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# Node / npm
frontend/node_modules/
frontend/dist/
# Coverage is reported on every run and read from the CI artifact, never committed.
frontend/coverage/
frontend/.vite/
# The root package.json has no dependencies, so nothing should install here (ADR-044). Vitest and npx
# still write a cache here when a frontend command is run from the root by mistake.
node_modules/

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Docker
.docker/

# Local tooling config — .claude/ is tracked (the project guide, .claude/CLAUDE.md);
# only machine-local agent state is ignored.
.claude/settings.local.json
