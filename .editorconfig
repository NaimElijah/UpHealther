# https://editorconfig.org
#
# What every editor should do with whitespace and line endings before a formatter runs. Java layout
# beyond that belongs to palantir-java-format through Spotless (ADR-037). The frontend has no Prettier,
# so for it this file is the only cross-editor statement of how its sources are written. Every value
# here is descriptive — it matches what the tracked files already contain rather than proposing a
# change to them.
#
# No max_line_length: the Java formatter owns the width, and the frontend's sources keep none, so
# declaring a limit here would make this file a wish rather than a description.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,sql,xml,py,conf}]
indent_size = 4

[*.{ts,tsx,js,cjs,mjs,json,css,html,yml,yaml}]
indent_size = 2

# Trailing spaces are not whitespace in Markdown — two of them are a hard line break, and trimming
# them silently changes the rendered document.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# cmd.exe needs CRLF, and .gitattributes checks *.cmd out that way; backend/mvnw.cmd is the only one
# (ADR-030).
[*.cmd]
end_of_line = crlf
