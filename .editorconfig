# https://editorconfig.org
#
# What every editor should do with whitespace and line endings before a formatter runs. Layout beyond
# that belongs to the formatters: palantir-java-format through Spotless for Java (ADR-037), and Prettier
# for the frontend (ADR-038), which also reads this file. Every value here is descriptive — it matches
# what the tracked files already contain rather than proposing a change to them.
#
# No max_line_length: the formatters own the width, and both use 120. palantir-java-format's is part of
# its fixed style; Prettier's is printWidth in frontend/prettier.config.js, which overrides any value
# here. A value here would be a second statement of the width that neither formatter reads.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,sql,xml,py,conf}]
indent_size = 4

[*.{ts,tsx,js,cjs,mjs,json,css,html,yml,yaml}]
indent_size = 2

# Trailing spaces are not whitespace in Markdown — two of them are a hard line break, and trimming
# them silently changes the rendered document.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# cmd.exe needs CRLF, and .gitattributes checks *.cmd out that way; backend/mvnw.cmd is the only one
# (ADR-030).
[*.cmd]
end_of_line = crlf
